# ── Environment / Secrets ─────────────────────────────────────
.env
.env.*
!.env.example

# ── Node dependencies ──────────────────────────────────────────
node_modules/
**/node_modules/

# ── Build output ───────────────────────────────────────────────
dist/
build/
**/dist/
**/build/

# ── Prisma generated client (regenerated on install) ──────────
backend/node_modules/.prisma/

# ── Uploads (user content, not source code) ───────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── OS files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ────────────────────────────────────────────────────
.vscode/
.idea/

# ── Backups ───────────────────────────────────────────────────
_backups/
